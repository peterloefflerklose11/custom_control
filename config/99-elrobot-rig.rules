# ElRobot rig -- stable names and access for one bimanual follower system.
# GENERATED by elrobot_assets/rig/rigmap.py; re-run `rigmap.py rules` to refresh.
# Self-contained: this is the only udev file the rig needs.
#
# Install:  sudo cp 99-elrobot-rig.rules /etc/udev/rules.d/
#           sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Two kinds of naming rule below, and the difference matters:
#
#   by serial -- survives being moved to any port on any hub.  A real identity,
#                and the one norma-core keys arms on.
#   by port   -- the device has no unique serial, so the socket it sits in IS
#                its identity.  Stable across reboot and renumbering, NOT across
#                being moved.  Move one and the name follows the socket, not the
#                device.  Label your sockets.


# --------------------------------------------------------------------------
# Access, by device class.  These hold for any ElRobot rig; nothing below this
# line is specific to one robot.

# ST3215 bus adapters enumerate as CDC-ACM (/dev/ttyACM*), and ModemManager
# AT-probes anything that looks like a modem.  That probe traffic collides with
# the 1 Mbaud servo protocol on the very same node, on every hotplug and boot.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", \
  ENV{ID_MM_DEVICE_IGNORE}="1", MODE="0660", GROUP="dialout"


# norma-core's usbvideo driver talks to cameras through libuvc/libusb and never
# opens a V4L2 node, so `video` group membership is irrelevant to it.  What
# governs access is /dev/bus/usb/*, root:root 0664 by default -- without this
# the station fails at uvc_open with LIBUSB_ERROR_ACCESS.

SUBSYSTEM=="usb", ATTR{idVendor}=="0c45", ATTR{idProduct}=="6366", MODE="0660", GROUP="plugdev"

SUBSYSTEM=="usb", ATTR{idVendor}=="32e4", ATTR{idProduct}=="2b10", MODE="0660", GROUP="plugdev"


# The foot pedal is a plain HID device.  systemd already grants the user sitting
# at the seat an ACL on it (TAG uaccess), which is enough at a desk and not
# enough anywhere else: a container, a service, or an ssh session all get denied.
# A group makes access explicit instead of dependent on who is logged in where.

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0fd9", ATTRS{idProduct}=="0086", MODE="0660", GROUP="plugdev"


# --------------------------------------------------------------------------
# Names, specific to THIS robot.  Regenerate after any recabling.

# left_follower: USB Single Serial, by serial (port independent)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5A68008537", SYMLINK+="elrobot/left_follower"

# right_follower: USB Single Serial, by serial (port independent)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5A68009964", SYMLINK+="elrobot/right_follower"

# left_wrist_cam: Innomaker-U20CAM-1080p-S1, by PORT -- serial 'SN0001' is not unique.
# Moving this device to another socket will move the name with the socket.
SUBSYSTEM=="video4linux", KERNELS=="1-4.1.2", ATTR{index}=="0", SYMLINK+="elrobot/left_wrist_cam"

# right_wrist_cam: Innomaker-U20CAM-1080p-S1, by PORT -- serial 'SN0001' is not unique.
# Moving this device to another socket will move the name with the socket.
SUBSYSTEM=="video4linux", KERNELS=="1-4.1.3.2", ATTR{index}=="0", SYMLINK+="elrobot/right_wrist_cam"

# overhead_stereo_cam: 3D USB Camera, by serial (port independent)
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="32e4", ATTRS{idProduct}=="2b10", ATTRS{serial}=="01.00.00", ATTR{index}=="0", SYMLINK+="elrobot/overhead_stereo_cam"

# left_leader: USB Single Serial, by serial (port independent)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5B3D042588", SYMLINK+="elrobot/left_leader"

# right_leader: USB Single Serial, by serial (port independent)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5B3D047066", SYMLINK+="elrobot/right_leader"

# pedal: Stream Deck Pedal, by serial (port independent)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0fd9", ATTRS{idProduct}=="0086", ATTRS{serial}=="A00YA5362IU2T8", SYMLINK+="elrobot/pedal"
