  "_gripper_hand_calibration": {
    "date": "2026-09-11",
    "why": "both gripper motors were replaced; the replacements' encoder zeros are arbitrary, so motor 8's arc had to be remeasured. Motors 1-7 and both leader buses are unchanged from calib_capture/calibration-backups/calibration-2026-09-11T12-12-39Z.json.",
    "span": {
      "method": "jaws held on each hard stop by hand, 25 samples per endpoint, zero spread; span = difference between the two readings in one offset frame",
      "left_follower": {
        "counts": 1304,
        "degrees": 114.6
      },
      "right_follower": {
        "counts": 1366,
        "degrees": 120.1
      },
      "caveat": "both ~17 deg narrower than the motors they replaced (133.2 / 136.8) and 6-12 deg under the URDF's 126.2. Conservative: angle_to_count clamps inside the measured travel, which also makes the open-end position these jaws wedge at unreachable."
    },
    "placement": {
      "method": "pin_offset.py --shut, closed-loop on the measured position. The span and the placement are separate facts: freeze_calibration factory-resets each motor before rewriting it, which discards the raw encoder frame an endpoint measurement was taken in. So the offsets here were set AFTER the freeze, from the jaws held shut.",
      "invariant": "with the jaws shut, PresentPosition reads range_min",
      "left_follower": {
        "offset": -278
      },
      "right_follower": {
        "offset": -1167
      }
    },
    "open_end": "NOT yet confirmed against the robot -- inferred from the measured span. Hold the jaws fully open and check PresentPosition reads range_max (2700 left, 2731 right)."
  }
